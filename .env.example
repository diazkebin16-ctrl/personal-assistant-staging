# Non-secret local configuration template for personal-assistant 0.13.x.
APP_NAME=personal-assistant-backend
APP_VERSION=0.13.0
ENVIRONMENT=local
LOG_LEVEL=INFO
PORT=8000

# Configure deployment-specific values outside source control.
DATABASE_URL=
SUPABASE_URL=
SUPABASE_ANON_KEY=
SUPABASE_SERVICE_ROLE_KEY=
SUPABASE_JWT_AUDIENCE=authenticated
SUPABASE_JWT_ISSUER=
SUPABASE_JWKS_URL=
AUTH_JWKS_CACHE_TTL=600
AUTH_JWKS_TIMEOUT_SECONDS=5

SENTRY_DSN=
OTEL_ENABLED=false
ORCHESTRATOR_MODE=NORMAL
ORCHESTRATOR_AI_ENABLED=true
ORCHESTRATOR_ACTIONS_ENABLED=true
RESEARCH_ENABLED=false
VOICE_CREDENTIAL_TTL_SECONDS=120
VOICE_CONNECTION_TIMEOUT_SECONDS=10
VOICE_IDLE_TIMEOUT_SECONDS=45
VOICE_MAX_SESSION_SECONDS=900
VOICE_MAX_RECONNECT_ATTEMPTS=3
# Server-owned configurable profile; never a provider credential or client override.
VOICE_PROFILE=calm-professional-v1
